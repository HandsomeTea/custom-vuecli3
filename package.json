{
	"name": "custom-vuecli3",
	"version": "1.0.0",
	"description": "custom code with vue-cli 3",
	"main": "index.js",
	"scripts": {
		"serve": "./node_modules/.bin/vue-cli-service serve --mode development",
		"start": "npm run serve",
		"build": "./node_modules/.bin/vue-cli-service build --mode production",
		"build:test": "./node_modules/.bin/vue-cli-service build --mode testprod",
		"build:view": "./node_modules/.bin/vue-cli-service build -build-view",
		"upgrade": "./node_modules/.bin/npm-check -u",
		"lint": "./node_modules/.bin/vue-cli-service lint",
		"webpack-rules": "vue inspect --rules > webpack.default.rules.txt",
		"webpack-plugins": "vue inspect --plugins > webpack.default.plugins.txt",
		"husky-init": "./node_modules/.bin/husky init"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HandsomeTea/custom-vuecli3.git"
	},
	"keywords": [
		"vue-cli3",
		"typecsript"
	],
	"author": "handsometea.coco@gmail.com",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/HandsomeTea/custom-vuecli3/issues"
	},
	"homepage": "https://github.com/HandsomeTea/custom-vuecli3#readme",
